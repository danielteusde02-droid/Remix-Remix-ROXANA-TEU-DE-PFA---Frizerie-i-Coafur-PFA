# SUPABASE CONFIGURATION (Frontend / Vite - Public Keys Only)
# Add these variables in Netlify -> Site configuration -> Environment variables
# Accepts both legacy anon JWT keys (eyJ...) and new publishable keys (sb_publishable_...)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_public_key_here"

# CLOUDFLARE TURNSTILE ANTI-BOT (Mandatory Frontend Public Site Key)
# Note: Secret key (TURNSTILE_SECRET_KEY) and SUPABASE_SERVICE_ROLE_KEY must ONLY be set in
# Supabase Edge Functions Secrets (`supabase secrets set TURNSTILE_SECRET_KEY=...`), NEVER in frontend!
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAC9vn34-a32h2x7O"

# GOOGLE MAPS JAVASCRIPT API KEY (Optional - Embed mode works without any API key)
VITE_GOOGLE_MAPS_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
